# Base URL backend, termasuk prefix /api. Hanya dibaca di server.
API_BASE_URL=http://localhost:3000/api

# Public URL folder utama audio lesson. Subfolder ditentukan melalui atribut `data-audio`.
# Contoh untuk bucket public `nnh` dan folder `audio`:
# https://<PROJECT_REF>.supabase.co/storage/v1/object/public/nnh/audio
PUBLIC_LESSON_AUDIO_BASE_URL=

# Google OAuth Web client ID untuk tombol Google Sign-In (publik). Kosongkan untuk menyembunyikan tombol.
PUBLIC_GOOGLE_CLIENT_ID=
